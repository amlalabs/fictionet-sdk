#!/usr/bin/env bash
# demos/dashboard: the web world in your browser, live, with fictionet dashboard.
#
# One command, no root: it boots the Fictionet VM if it is not running
# (vm/run up), runs demos/guest/dashboard.sh inside it, and cleans up. See
# demos/README.md.
exec "$(dirname "$0")/../vm/run" demo dashboard "$@"
