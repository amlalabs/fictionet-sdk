#!/usr/bin/env bash
# demos/border: Border's scripted episode: the real bank, then a BGP hijack and an impostor.
#
# One command, no root: it boots the Fictionet VM if it is not running
# (vm/run up), runs demos/guest/border.sh inside it, and cleans up. See
# demos/README.md.
exec "$(dirname "$0")/../vm/run" demo border "$@"
