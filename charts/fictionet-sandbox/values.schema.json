              ]
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "worldWait": {
              "type": "integer",
              "minimum": 0
            },
            "downLinks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ipAddr": {
              "type": "string"
            },
            "gateway": {
              "type": "string"
            },
            "dns": {
              "type": "string"
            },
            "ipAddrV6": {
              "type": "string"
            },
            "gatewayV6": {
